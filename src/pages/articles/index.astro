---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import ArticleListItem from '../../components/shared/ArticleListItem.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import { ui } from '../../config/ui.ts';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<BaseLayout
  title={ui.article.indexSeoTitle}
  description={ui.article.indexSeoDescription}
  canonical="/articles/"
>
  <SiteHeader />
  <main id="main-content">
    <section class="page-header section">
      <div class="wrap">
        <p class="section-label">{ui.article.latestEyebrow}</p>
        <h1>{ui.article.indexTitle}</h1>
        <p>{ui.article.indexLead}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        {articles.length === 0 ? (
          <p class="text-center text-slate-500 py-12">{ui.article.emptyList}</p>
        ) : (
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {articles.map((article) => <ArticleListItem article={article} />)}
          </ul>
        )}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
