---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { ui } from '../config/ui.ts';
import { site } from '../config/site.ts';
import { home } from '../config/home.ts';
import { validateContentRelations } from '../utils/content-validation.ts';
import { getScheduleStatus } from '../utils/schedule.ts';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('Missing "home" page content entry.');
if (homeEntry.data.draft) throw new Error('Page "home" is marked draft but has a statically defined route.');

// Validasi integritas konten (slug/ULID unik, relasi, format tanggal jadwal).
await validateContentRelations();

// Jadwal angkatan dari koleksi konten; status awal dihitung saat build,
// lalu diperbarui oleh skrip klien schedule-status.ts.
const batches = (await getCollection('schedule'))
  .filter((batch) => !batch.data.draft)
  .sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));

const jadwal = batches.map((batch) => ({
  no: batch.data.batchNo,
  tanggal: batch.data.dateLabel,
  metode: batch.data.mode,
  start: batch.data.startDate,
  end: batch.data.endDate,
  href: `/jadwal/${batch.data.slug}/`,
  status: getScheduleStatus(batch.data.startDate, batch.data.endDate),
}));

const origin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const absolute = (path: string) => new URL(path, origin).toString();

const homeJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': `${origin}/#venue`,
      name: site.venue,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, Kelurahan ${site.address.village}`,
        addressLocality: site.address.city,
        addressRegion: site.address.province,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
    },
    {
      '@type': 'Course',
      '@id': `${origin}/#course`,
      name: 'Pelatihan Teknisi K3 Ruang Terbatas (Confined Space) Kemnaker RI',
      description:
        'Program pelatihan dan pembinaan untuk menyiapkan tenaga kerja menerapkan keselamatan kerja, mengidentifikasi bahaya, mengendalikan risiko, menggunakan APD, mengukur atmosfer, dan memahami prosedur penyelamatan di ruang terbatas sesuai Permenaker Nomor 11 Tahun 2023.',
      url: `${origin}/`,
      image: absolute(ui.meta.defaultImage),
      inLanguage: 'id',
      provider: { '@id': `${origin}/#organization` },
      
      coursePrerequisites: home.requirement.items.slice(0, 5).map((item) => item.replace(/\.$/, '')),
      teaches: home.program.items.map((item) => item.title),
      offers: [
        {
          '@type': 'Offer',
          category: 'Paid',
          price: String(home.pricing.value),
          priceCurrency: home.pricing.currencyCode,
          image: absolute(ui.meta.defaultImage),
          availability: 'https://schema.org/InStock',
          url: `${origin}/#harga`,
        },
      ],
      hasCourseInstance: batches.map((batch) => ({
        '@type': 'CourseInstance',
        name: batch.data.title,
        description: batch.data.description,
        courseMode: 'Blended',
        startDate: batch.data.startDate,
        endDate: batch.data.endDate,
        location: { '@id': `${origin}/#venue` },
        url: `${origin}/jadwal/${batch.data.slug}/`,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${origin}/#faq`,
      mainEntity: home.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
}).replace(/</g, '\\u003c');
---
<BaseLayout
  title={homeEntry.data.seoTitle ?? homeEntry.data.title}
  description={homeEntry.data.description}
  socialImage={homeEntry.data.socialImage}
  imageAlt={home.hero.image.alt}
  canonical={homeEntry.data.canonical}
  noindex={homeEntry.data.noindex}
  pubDate={homeEntry.data.pubDate}
  updatedDate={homeEntry.data.updatedDate}
  mainEntityId={`${origin}/#faq`}
  aboutId={`${origin}/#course`}
>
  <script type="application/ld+json" set:html={homeJsonLd} slot="head" />

  <SiteHeader variant="home" />

  <main id="main-content">

    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image">
        <img
          src={home.hero.image.src}
          alt={home.hero.image.alt}
          width={home.hero.image.width}
          height={home.hero.image.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="wrap hero-content">
        <p class="eyebrow">{home.hero.eyebrow}</p>

        <h1 id="hero-title">
          {home.hero.title}
          <span class="h1-sub">{home.hero.subtitle}</span>
        </h1>

        <p class="hero-lead" set:html={home.hero.leadHtml} />

        <div class="hero-actions">
          <a href={site.documents.silabus} class="btn btn-gold" target="_blank" rel="noopener">
            {home.hero.silabusLabel} <span class="sr-only">{ui.a11y.pdfSuffix}</span>
          </a>
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa"/></svg>
            {home.hero.daftarLabel} <span class="sr-only">via WhatsApp {ui.a11y.newTabSuffix}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- STATISTIK -->
    <section class="stats" aria-label={ui.stats.ariaLabel}>
      <div class="wrap">
        <div class="card-cert">
          <div class="card-cert-intro">
            <p class="card-cert-title">{home.stats.title}</p>
            <p>{home.stats.subtitle}</p>
          </div>

          <dl class="stat-list">
            {home.stats.items.map((item) => (
              <div class="stat">
                <dt>{item.label}</dt>
                <dd data-count={item.count} data-suffix={item.suffix}>{item.display}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- LEGALITAS -->
    <section class="legal-section section" id="legalitas" aria-labelledby="legal-title">
      <div class="wrap">
        <div class="legal-grid">
          <div class="legal-content">
            <p class="section-label">{home.legal.eyebrow}</p>

            <h2 id="legal-title" set:html={home.legal.headingHtml} />

            {home.legal.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}

            <ul class="check-list" role="list">
              {home.legal.items.map((item) => (
                <li><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
              ))}
            </ul>
          </div>

          <figure class="certificate-card legal-image">
            {home.legal.image.originalSrc && (
              <a href={home.legal.image.originalSrc} target="_blank" rel="noopener noreferrer" aria-label="Buka ukuran asli">
                <img
                  src={home.legal.image.src}
                  alt={home.legal.image.alt}
                  width={home.legal.image.width}
                  height={home.legal.image.height}
                  loading="lazy" decoding="async"
                />
              </a>
            )}{!home.legal.image.originalSrc && (
              <img
                src={home.legal.image.src}
                alt={home.legal.image.alt}
                width={home.legal.image.width}
                height={home.legal.image.height}
                loading="lazy" decoding="async"
              />
            )}
            <figcaption>{home.legal.image.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- TENTANG -->
    <section class="about section" id="tentang" aria-labelledby="about-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.about.eyebrow}</p>
          <h2 id="about-title">{home.about.heading}</h2>
        </header>

        <div class="about-grid">
          <div class="about-text">
            {home.about.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            <a class="text-link" href={home.about.linkHref}>
              {home.about.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <figure class="about-media">
            <img
              src={home.about.image.src}
              alt={home.about.image.alt}
              width={home.about.image.width}
              height={home.about.image.height}
              loading="lazy" decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- MATERI PELATIHAN -->
    <section class="program section" id="program" aria-labelledby="program-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.program.eyebrow}</p>
          <h2 id="program-title">{home.program.heading}</h2>
          <p>{home.program.description}</p>
        </header>

        <ul class="program-grid" role="list">
          {home.program.items.map((item) => (
            <li class="program-card">
              <span class="program-icon" aria-hidden="true" set:html={item.icon} />
              <div class="program-content">
                <h3>{item.title}</h3>
                <p set:html={item.textHtml} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PERSYARATAN -->
    <section class="requirement-section section" id="persyaratan" aria-labelledby="req-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.requirement.eyebrow}</p>
          <h2 id="req-title">{home.requirement.heading}</h2>
        </header>

        <ul class="requirement-grid" role="list">
          {home.requirement.items.map((item) => (
            <li class="requirement-item"><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- BENEFIT -->
    <section class="benefit-section section" id="benefit" aria-labelledby="benefit-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.benefit.eyebrow}</p>
          <h2 id="benefit-title">{home.benefit.heading}</h2>
        </header>

        <ul class="benefit-grid" role="list">
          {home.benefit.items.map((item) => (
            <li class="benefit-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- JADWAL PELATIHAN -->
    <section class="schedule-section section" id="jadwal" aria-labelledby="schedule-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.schedule.eyebrow}</p>
          <h2 id="schedule-title">{home.schedule.heading}</h2>
        </header>

        <div class="table-wrap">
          <table class="schedule-table">
            <caption class="sr-only">{home.schedule.tableCaption}</caption>
            <thead>
              <tr>
                {ui.jadwal.tableHeaders.map((header) => (
                  <th scope="col">{header}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {jadwal.map((row) => (
                <tr data-start={row.start} data-end={row.end}>
                  <td data-label="No">{row.no}</td>
                  <td data-label="Tanggal"><a href={row.href}>{row.tanggal}</a></td>
                  <td data-label="Metode">{row.metode}</td>
                  <td data-label="Status"><span class={`status ${row.status === 'closed' ? 'is-closed' : row.status === 'ongoing' ? 'is-ongoing' : 'is-open'}`}>{row.status === 'open' ? ui.jadwal.statusOpen : row.status === 'ongoing' ? ui.jadwal.statusOngoing : ui.jadwal.statusClosed}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="schedule-note" set:html={home.schedule.note} />
      </div>
    </section>

    <!-- GALERI -->
    <section class="gallery section" id="galeri" aria-labelledby="gallery-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.gallery.eyebrow}</p>
          <h2 id="gallery-title">{home.gallery.heading}</h2>
        </header>

        <ul class="gallery-grid" role="list">
          {home.gallery.items.map((item) => (
            <li class="gallery-item">
              <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- BIAYA -->
    <section class="pricing-section section" id="harga" aria-labelledby="price-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.pricing.eyebrow}</p>
          <h2 id="price-title">{home.pricing.heading}</h2>
          <p>{home.pricing.description}</p>
        </header>

        <div class="pricing-card">
          <div class="price-head">
            <p class="price-from">{home.pricing.fromLabel}</p>
            <p class="price-amount"><span class="currency">{home.pricing.currency}</span>{home.pricing.amount}</p>
            <p class="price-unit">{home.pricing.unit}</p>
          </div>

          <ul class="price-list" role="list">
            {home.pricing.includes.map((item) => (
              <li><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
            ))}
          </ul>

          <div class="price-button">
            <a href={site.documents.formulir} class="btn btn-navy" download>
              <svg aria-hidden="true"><use href="#i-file"/></svg>
              {home.pricing.formulirLabel} <span class="sr-only">{ui.a11y.docSuffix}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section section" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.faq.eyebrow}</p>
          <h2 id="faq-title">{home.faq.heading}</h2>
        </header>

        <div class="faq-list">
          {home.faq.items.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="cta-section section" id="kontak" aria-labelledby="cta-title">
      <div class="container cta-box">
        <p class="section-label">{home.cta.eyebrow}</p>

        <h2 id="cta-title">{home.cta.heading}</h2>

        <p>{home.cta.text}</p>

        <div class="cta-button">
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa"/></svg>
            {home.cta.primaryLabel} <span class="sr-only">{ui.a11y.newTabSuffix}</span>
          </a>
          <a href={site.documents.formulir} class="btn btn-outline-light" download>
            {home.cta.secondaryLabel} <span class="sr-only">{ui.a11y.docSuffix}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ARTIKEL TERBARU — disimpan sebelum penutup </main> -->
    {homeEntry.data.blocks.map((block) => <BlockRenderer block={block} />)}

  </main>
  <SiteFooter serviceTitle="Teknisi K3 Ruang Terbatas" />
</BaseLayout>

<script defer src="/scripts/schedule-status.js"></script>
<script defer src="/scripts/home.js"></script>
