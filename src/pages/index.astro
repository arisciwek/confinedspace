---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { ui } from '../config/ui.ts';
import { site } from '../config/site.ts';
import { home } from '../config/home.ts';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) throw new Error('Missing "home" page content entry.');
if (homeEntry.data.draft) throw new Error('Page "home" is marked draft but has a statically defined route.');

const origin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const absolute = (path: string) => new URL(path, origin).toString();

// Status awal baris jadwal dihitung saat build; skrip klien memperbaruinya otomatis.
const todayStart = new Date();
todayStart.setHours(0, 0, 0, 0);
const jadwal = home.schedule.rows.map((row) => ({
  ...row,
  open: new Date(`${row.end}T23:59:59`).getTime() >= todayStart.getTime(),
}));

const homeJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Place',
      '@id': `${origin}/#venue`,
      name: site.venue,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, Kelurahan ${site.address.village}`,
        addressLocality: site.address.city,
        addressRegion: site.address.province,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
    },
    {
      '@type': 'Course',
      '@id': `${origin}/#course`,
      name: 'Pelatihan Teknisi K3 Ruang Terbatas (Confined Space) Kemnaker RI',
      description:
        'Program sertifikasi resmi Kemnaker RI untuk membekali tenaga kerja dalam identifikasi bahaya, pengendalian risiko, sistem izin kerja, penggunaan APD, pengukuran atmosfer, dan prosedur penyelamatan di ruang terbatas sesuai Permenaker Nomor 11 Tahun 2023.',
      url: `${origin}/`,
      image: absolute(ui.meta.defaultImage),
      inLanguage: 'id',
      provider: { '@id': `${origin}/#organization` },
      educationalCredentialAwarded: 'Sertifikat dan Lisensi Teknisi K3 Ruang Terbatas Kemnaker RI',
      coursePrerequisites: home.requirement.items.slice(0, 5).map((item) => item.replace(/\.$/, '')),
      teaches: home.program.items.map((item) => item.title),
      offers: [
        {
          '@type': 'Offer',
          category: 'Paid',
          price: String(home.pricing.value),
          priceCurrency: home.pricing.currencyCode,
          availability: 'https://schema.org/InStock',
          url: `${origin}/#harga`,
        },
      ],
      hasCourseInstance: jadwal.map((row) => ({
        '@type': 'CourseInstance',
        name: `Jadwal No. ${row.no}`,
        courseMode: 'Blended',
        startDate: row.start,
        endDate: row.end,
        location: { '@id': `${origin}/#venue` },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${origin}/#faq`,
      mainEntity: home.faq.items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
}).replace(/</g, '\\u003c');
---
<BaseLayout
  title={homeEntry.data.seoTitle ?? homeEntry.data.title}
  description={homeEntry.data.description}
  socialImage={homeEntry.data.socialImage}
  imageAlt={home.hero.image.alt}
  canonical={homeEntry.data.canonical}
  noindex={homeEntry.data.noindex}
  pubDate={homeEntry.data.pubDate}
  updatedDate={homeEntry.data.updatedDate}
  mainEntityId={`${origin}/#faq`}
  aboutId={`${origin}/#course`}
>
  <script type="application/ld+json" set:html={homeJsonLd} slot="head" />

  <!-- Sprite ikon (dipakai ulang lewat <use>) -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></symbol>
    <symbol id="i-wa" viewBox="0 0 24 24"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.5 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-6-6Zm0 0v6h6M12 12v6m-3-3 3 3 3-3"/></symbol>
  </svg>

  <SiteHeader variant="home" />

  <main id="main-content">

    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image">
        <img
          src={home.hero.image.src}
          alt={home.hero.image.alt}
          width={home.hero.image.width}
          height={home.hero.image.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="wrap hero-content">
        <p class="eyebrow">{home.hero.eyebrow}</p>

        <h1 id="hero-title">
          {home.hero.title}
          <span class="h1-sub">{home.hero.subtitle}</span>
        </h1>

        <p class="hero-lead" set:html={home.hero.leadHtml} />

        <div class="hero-actions">
          <a href={site.documents.silabus} class="btn btn-gold" target="_blank" rel="noopener">
            {home.hero.silabusLabel} <span class="sr-only">{ui.a11y.pdfSuffix}</span>
          </a>
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa"/></svg>
            {home.hero.daftarLabel} <span class="sr-only">via WhatsApp {ui.a11y.newTabSuffix}</span>
          </a>
        </div>
      </div>
    </section>

    <!-- STATISTIK -->
    <section class="stats" aria-label={ui.stats.ariaLabel}>
      <div class="wrap">
        <div class="card-cert">
          <div class="card-cert-intro">
            <p class="card-cert-title">{home.stats.title}</p>
            <p>{home.stats.subtitle}</p>
          </div>

          <dl class="stat-list">
            {home.stats.items.map((item) => (
              <div class="stat">
                <dt>{item.label}</dt>
                <dd data-count={item.count} data-suffix={item.suffix}>{item.display}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- LEGALITAS -->
    <section class="legal-section section" id="legalitas" aria-labelledby="legal-title">
      <div class="wrap">
        <div class="legal-grid">
          <div class="legal-content">
            <p class="section-label">{home.legal.eyebrow}</p>

            <h2 id="legal-title" set:html={home.legal.headingHtml} />

            {home.legal.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}

            <ul class="check-list" role="list">
              {home.legal.items.map((item) => (
                <li><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
              ))}
            </ul>
          </div>

          <figure class="certificate-card legal-image">
            <img
              src={home.legal.image.src}
              alt={home.legal.image.alt}
              width={home.legal.image.width}
              height={home.legal.image.height}
              loading="lazy" decoding="async"
            />
            <figcaption>{home.legal.image.caption}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- TENTANG -->
    <section class="about section" id="tentang" aria-labelledby="about-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.about.eyebrow}</p>
          <h2 id="about-title">{home.about.heading}</h2>
        </header>

        <div class="about-grid">
          <div class="about-text">
            {home.about.paragraphs.map((paragraph) => (
              <p set:html={paragraph} />
            ))}
            <a class="text-link" href={home.about.linkHref}>
              {home.about.linkLabel} <span aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <figure class="about-media">
            <img
              src={home.about.image.src}
              alt={home.about.image.alt}
              width={home.about.image.width}
              height={home.about.image.height}
              loading="lazy" decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- MATERI PELATIHAN -->
    <section class="program section" id="program" aria-labelledby="program-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.program.eyebrow}</p>
          <h2 id="program-title">{home.program.heading}</h2>
          <p>{home.program.description}</p>
        </header>

        <ul class="program-grid" role="list">
          {home.program.items.map((item) => (
            <li class="program-card">
              <span class="program-icon" aria-hidden="true" set:html={item.icon} />
              <div class="program-content">
                <h3>{item.title}</h3>
                <p set:html={item.textHtml} />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- PERSYARATAN -->
    <section class="requirement-section section" id="persyaratan" aria-labelledby="req-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.requirement.eyebrow}</p>
          <h2 id="req-title">{home.requirement.heading}</h2>
        </header>

        <ul class="requirement-grid" role="list">
          {home.requirement.items.map((item) => (
            <li class="requirement-item"><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- BENEFIT -->
    <section class="benefit-section section" id="benefit" aria-labelledby="benefit-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.benefit.eyebrow}</p>
          <h2 id="benefit-title">{home.benefit.heading}</h2>
        </header>

        <ul class="benefit-grid" role="list">
          {home.benefit.items.map((item) => (
            <li class="benefit-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- JADWAL PELATIHAN -->
    <section class="schedule-section section" id="jadwal" aria-labelledby="schedule-title">
      <div class="wrap">
        <header class="section-title">
          <p class="section-label">{home.schedule.eyebrow}</p>
          <h2 id="schedule-title">{home.schedule.heading}</h2>
        </header>

        <div class="table-wrap">
          <table class="schedule-table">
            <caption class="sr-only">{home.schedule.tableCaption}</caption>
            <thead>
              <tr>
                {home.schedule.headers.map((header) => (
                  <th scope="col">{header}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {jadwal.map((row) => (
                <tr data-end={row.end}>
                  <td data-label="No">{row.no}</td>
                  <td data-label="Tanggal">{row.tanggal}</td>
                  <td data-label="Metode">{row.metode}</td>
                  <td data-label="Status"><span class={`status ${row.open ? 'is-open' : 'is-closed'}`}>{row.open ? 'Dibuka' : 'Ditutup'}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="schedule-note" set:html={home.schedule.note} />
      </div>
    </section>

    <!-- GALERI -->
    <section class="gallery section" id="galeri" aria-labelledby="gallery-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.gallery.eyebrow}</p>
          <h2 id="gallery-title">{home.gallery.heading}</h2>
        </header>

        <ul class="gallery-grid" role="list">
          {home.gallery.items.map((item) => (
            <li class="gallery-item">
              <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- BIAYA -->
    <section class="pricing-section section" id="harga" aria-labelledby="price-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.pricing.eyebrow}</p>
          <h2 id="price-title">{home.pricing.heading}</h2>
          <p>{home.pricing.description}</p>
        </header>

        <div class="pricing-card">
          <div class="price-head">
            <p class="price-from">{home.pricing.fromLabel}</p>
            <p class="price-amount"><span class="currency">{home.pricing.currency}</span>{home.pricing.amount}</p>
            <p class="price-unit">{home.pricing.unit}</p>
          </div>

          <ul class="price-list" role="list">
            {home.pricing.includes.map((item) => (
              <li><span class="check-icon" aria-hidden="true"><svg><use href="#i-check"/></svg></span>{item}</li>
            ))}
          </ul>

          <div class="price-button">
            <a href={site.documents.formulir} class="btn btn-navy" download>
              <svg aria-hidden="true"><use href="#i-file"/></svg>
              {home.pricing.formulirLabel} <span class="sr-only">{ui.a11y.docSuffix}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section section" id="faq" aria-labelledby="faq-title">
      <div class="wrap">
        <header class="section-title center">
          <p class="section-label">{home.faq.eyebrow}</p>
          <h2 id="faq-title">{home.faq.heading}</h2>
        </header>

        <div class="faq-list">
          {home.faq.items.map((item, index) => (
            <details open={index === 0}>
              <summary>{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="cta-section section" id="kontak" aria-labelledby="cta-title">
      <div class="container cta-box">
        <p class="section-label">{home.cta.eyebrow}</p>

        <h2 id="cta-title">{home.cta.heading}</h2>

        <p>{home.cta.text}</p>

        <div class="cta-button">
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa"/></svg>
            {home.cta.primaryLabel} <span class="sr-only">{ui.a11y.newTabSuffix}</span>
          </a>
          <a href={site.documents.formulir} class="btn btn-outline-light" download>
            {home.cta.secondaryLabel} <span class="sr-only">{ui.a11y.docSuffix}</span>
          </a>
        </div>
      </div>
    </section>

  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  /* Parallax ringan pada gambar hero (satu listener pasif + rAF) */
  const heroImg = document.querySelector<HTMLImageElement>('.hero-image img');
  let ticking = false;

  const onScroll = () => {
    const y = window.scrollY;
    if (heroImg && !reduceMotion && y < window.innerHeight * 1.2) {
      heroImg.style.transform = `translate3d(0, ${y * 0.25}px, 0) scale(1.08)`;
    }
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(onScroll);
    }
  }, { passive: true });
  onScroll();

  /* Navigasi aktif mengikuti section yang terlihat */
  const nav = document.getElementById('main-nav');
  const navLinks = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
  const linkById = new Map(navLinks.map((a) => [a.getAttribute('href')?.slice(1) ?? '', a]));
  const trackedSections = [...linkById.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if ('IntersectionObserver' in window && trackedSections.length) {
    const navObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((a) => {
          a.classList.remove('is-active');
          a.removeAttribute('aria-current');
        });
        const link = linkById.get(entry.target.id);
        if (link) {
          link.classList.add('is-active');
          link.setAttribute('aria-current', 'location');
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });

    trackedSections.forEach((section) => navObserver.observe(section));
  }

  /* Scroll reveal */
  const revealTargets = document.querySelectorAll(
    '.section-title, .program-card, .benefit-card, .requirement-item, .gallery-item, .faq-list details, .about-grid, .legal-grid, .pricing-card, .table-wrap'
  );

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const revealObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    revealTargets.forEach((el, i) => {
      el.classList.add('reveal');
      el.style.transitionDelay = `${(i % 3) * 70}ms`;
      revealObserver.observe(el);
    });
  }

  /* Counter statistik — angka final sudah ada di HTML; animasi hanya kosmetik */
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const fmt = new Intl.NumberFormat('id-ID');

  const runCounter = (el: HTMLElement) => {
    const target = parseInt(el.dataset.count ?? '0', 10);
    const suffix = el.dataset.suffix ?? '';
    const duration = 1400;
    const start = performance.now();

    const step = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = fmt.format(Math.round(target * eased)) + suffix;
      if (t < 1) requestAnimationFrame(step);
    };

    requestAnimationFrame(step);
  };

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const counterObserver = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          runCounter(entry.target as HTMLElement);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.6 });

    counters.forEach((counter) => counterObserver.observe(counter));
  }

  /* Tilt 3D kartu materi (hanya pointer presisi) */
  if (finePointer && !reduceMotion) {
    document.querySelectorAll<HTMLElement>('.program-card').forEach((card) => {
      let frame = 0;

      card.addEventListener('mousemove', (e) => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const r = card.getBoundingClientRect();
          const rx = ((r.height / 2) - (e.clientY - r.top)) / 22;
          const ry = ((e.clientX - r.left) - (r.width / 2)) / 22;
          card.style.transform = `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-6px)`;
        });
      });

      card.addEventListener('mouseleave', () => {
        cancelAnimationFrame(frame);
        card.style.transform = '';
      });
    });
  }

  /* Status jadwal otomatis (Dibuka / Ditutup) berdasarkan tanggal lokal */
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  document.querySelectorAll<HTMLTableRowElement>('tr[data-end]').forEach((row) => {
    const [y, m, d] = (row.dataset.end ?? '').split('-').map(Number);
    const endDate = new Date(y, m - 1, d);
    const status = row.querySelector('.status');
    if (!status) return;

    const isOpen = endDate >= today;
    status.textContent = isOpen ? 'Dibuka' : 'Ditutup';
    status.classList.toggle('is-open', isOpen);
    status.classList.toggle('is-closed', !isOpen);
  });
</script>
