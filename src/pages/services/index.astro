---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import ServiceListBlock from '../../components/shared/ServiceListBlock.astro';
import { ui } from '../../config/ui.ts';

// Hero dan daftar layanan di halaman ini sudah dirakit lewat komponen di bawah,
// jadi hanya block artikel terbaru (article-list) dari content yang dirender.
const servicesPage = await getEntry('pages', 'services');
if (!servicesPage) throw new Error('Missing "services" page content entry.');
const articleListBlocks = servicesPage.data.blocks.filter((block) => block.component === 'article-list');
---
<BaseLayout title={ui.services.listingTitle} description={ui.services.listingDescription}>
  <SiteHeader />
  <main id="main-content" class="services-index">
    <header class="services-index__hero">
      <div class="wrap">
        <nav class="services-index__breadcrumb" aria-label={ui.nav.breadcrumbAriaLabel}>
          <ol><li><a href="/">{ui.nav.home}</a></li><li aria-current="page">{ui.nav.services}</li></ol>
        </nav>
        <p class="section-label">{ui.services.listingEyebrow}</p>
        <h1>{ui.services.listingTitle}</h1>
        <p class="services-index__intro">{ui.services.listingIntro}</p>
      </div>
    </header>
    <section class="section services-index__listing" aria-label="Daftar program pelatihan">
      <div class="wrap">
        <ServiceListBlock
          id="daftar-program"
          variant="listing"
          columns={3}
          showBenefits={true}
        />
      </div>
    </section>

    <!-- ARTIKEL TERBARU #4–6 — disimpan sebelum penutup </main> -->
    {articleListBlocks.map((block) => <BlockRenderer block={block} />)}
  </main>
  <SiteFooter />
</BaseLayout>
