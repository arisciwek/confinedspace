---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import { ui } from '../../config/ui.ts';

const services = (await getCollection('services'))
  .filter((s) => !s.data.draft && s.data.status === 'active')
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={ui.services.listingTitle}
  description={ui.services.listingDescription}
>
  <SiteHeader />
  <main id="main-content">
    <section class="page-header section">
      <div class="wrap">
        <p class="section-label">{ui.services.listingEyebrow}</p>
        <h1>{ui.services.listingTitle}</h1>
        <p>{ui.services.listingIntro}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        {services.length === 0 ? (
          <p class="text-center text-slate-500 py-12">{ui.services.emptyList}</p>
        ) : (
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {services.map((service) => (
              <li>
                <article class="card-cert" style="grid-template-columns: 1fr; padding: 28px; border-top-width: 4px;">
                  <p class="section-label">{service.data.eyebrow}</p>
                  <h3 class="card-cert-title">{service.data.title}</h3>
                  <p style="margin-top: 8px; color: var(--muted);">{service.data.description}</p>
                  <footer style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border);">
                    <a href={`/services/${service.data.slug}/`} class="btn btn-outline-navy" style="min-height: 44px; padding: 0 24px;">{ui.services.readMore}</a>
                  </footer>
                </article>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
