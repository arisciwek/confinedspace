---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { ui } from '../../config/ui.ts';
import { site } from '../../config/site.ts';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services
    .filter((s) => !s.data.draft && s.data.status === 'active')
    .map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}

const { service } = Astro.props;

const origin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;
const canonicalPath = service.data.canonical ?? `/services/${service.data.slug}/`;
const serviceUrl = new URL(canonicalPath, origin).toString();

// FAQPage JSON-LD dirakit dari block faq pada konten (pola yang sama dengan ArticleLayout).
const faqBlock = service.data.blocks.find((block) => block.component === 'faq');
const faqJsonLd = faqBlock && 'items' in faqBlock ? {
  '@type': 'FAQPage',
  '@id': `${serviceUrl}#faq`,
  inLanguage: 'id-ID',
  mainEntity: faqBlock.items.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

// Service + Course schema spesifik per layanan
const serviceSchemaJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      name: service.data.title,
      description: service.data.intro ?? service.data.description,
      url: serviceUrl,
      image: service.data.socialImage ? new URL(service.data.socialImage, origin).toString() : undefined,
      provider: { '@id': `${origin}/#organization` },
      areaServed: site.areaServed.map((area) => ({ '@type': 'Country', name: area })),
      offers: {
        '@type': 'Offer',
        name: service.data.title,
        description: service.data.intro ?? service.data.description,
        url: serviceUrl,
        priceCurrency: 'IDR',
        availability: 'https://schema.org/InStock',
      },
      hasCourse: { '@id': `${origin}/#course` },
    },
    {
      '@type': 'Course',
      '@id': `${serviceUrl}#course`,
      name: service.data.title,
      description: service.data.intro ?? service.data.description,
      url: serviceUrl,
      image: service.data.socialImage ? new URL(service.data.socialImage, origin).toString() : undefined,
      provider: { '@id': `${origin}/#organization` },
      inLanguage: 'id',
      educationalCredentialAwarded: 'Sertifikat dan Lisensi Teknisi K3 Ruang Terbatas Kemnaker RI',
      hasCourseInstance: { '@id': `${origin}/#course` },
    },
    ...(faqJsonLd ? [faqJsonLd] : []),
  ],
}).replace(/</g, '\\u003c');

// Program K3 ruang terbatas lain untuk penautan internal antar halaman layanan.
const otherServices = (await getCollection('services'))
  .filter((s) => !s.data.draft && s.data.status === 'active' && s.data.slug !== service.data.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ href: `/services/${s.data.slug}/`, title: s.data.title, description: s.data.description }));
---
<BaseLayout
  title={service.data.title}
  description={service.data.description}
  socialImage={service.data.socialImage}
  canonical={service.data.canonical}
  noindex={service.data.noindex}
  pubDate={service.data.pubDate}
  updatedDate={service.data.updatedDate}
  mainEntityId={faqJsonLd ? `${serviceUrl}#faq` : undefined}
>
  <script type="application/ld+json" set:html={serviceSchemaJsonLd} slot="head" />

  <SiteHeader />
  <main id="main-content">
    <article class="service-hero section" aria-labelledby="service-title">
      <div class="wrap">
        <header>
          <p class="section-label">{service.data.eyebrow ?? ui.services.defaultEyebrow}</p>
          <h1 id="service-title">{service.data.title}</h1>
          <p style="margin-top: 16px; color: var(--muted); max-width: 760px;">{service.data.intro ?? service.data.description}</p>
        </header>
      </div>
    </article>

    <div class="wrap section">
      <div class="prose" style="max-width: 760px; margin: 0 auto;">
        {service.data.blocks.map((block) => <BlockRenderer block={block} />)}
      </div>
    </div>

    {otherServices.length > 0 && (
      <section class="section" style="background: var(--light);" aria-labelledby="other-programs-title">
        <div class="wrap">
          <header class="section-title center">
            <p class="section-label">{ui.services.listingEyebrow}</p>
            <h2 id="other-programs-title">{ui.services.otherProgramsHeading}</h2>
          </header>
          <ul class="grid gap-6 sm:grid-cols-2" role="list">
            {otherServices.map((program) => (
              <li>
                <article class="card-cert" style="grid-template-columns: 1fr; padding: 28px; border-top-width: 4px;">
                  <h3 class="card-cert-title">{program.title}</h3>
                  <p style="margin-top: 8px; color: var(--muted);">{program.description}</p>
                  <footer style="margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border);">
                    <a href={program.href} class="btn btn-outline-navy" style="min-height: 44px; padding: 0 24px;">{ui.services.readMore}</a>
                  </footer>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="cta-section section" aria-labelledby="service-cta-title">
      <div class="container cta-box">
        <p class="section-label">{ui.ctaBlock.eyebrow}</p>
        <h2 id="service-cta-title">{ui.ctaBlock.heading}</h2>
        <p>{ui.ctaBlock.text}</p>
        <div class="cta-button">
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa"/></svg>
            {ui.ctaBlock.defaultButton} <span class="sr-only">{ui.a11y.newTabSuffix}</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter serviceTitle={service.data.title} />
</BaseLayout>
