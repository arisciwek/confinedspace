---
import { getCollection } from 'astro:content';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import SiteHeader from '../../components/shared/SiteHeader.astro';
import SiteFooter from '../../components/shared/SiteFooter.astro';
import BlockRenderer from '../../components/blocks/BlockRenderer.astro';
import { ui } from '../../config/ui.ts';
import { site } from '../../config/site.ts';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services
    .filter((entry) => !entry.data.draft && entry.data.status === 'active')
    .map((service) => ({ params: { slug: service.data.slug }, props: { service } }));
}

const { service } = Astro.props;
const data = service.data;
const origin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const canonicalPath = data.canonical ?? `/services/${data.slug}/`;
const serviceUrl = new URL(canonicalPath, origin).toString();
const pageImage = data.image ?? data.socialImage;
const pageImageUrl = pageImage ? new URL(pageImage, origin).toString() : undefined;

const blockHeading = (block: (typeof data.blocks)[number]) => {
  if ('heading' in block && block.heading) return block.heading;
  if ('title' in block && block.title) return block.title;
  return undefined;
};

const navigationItems = data.blocks
  .map((block) => {
    const label = blockHeading(block);
    if (!label || !('id' in block) || !block.id) return null;
    return { id: block.id, label };
  })
  .filter((item): item is { id: string; label: string } => item !== null);

const faqBlock = data.blocks.find((block) => block.component === 'faq');
const faqJsonLd = faqBlock && 'items' in faqBlock ? {
  '@type': 'FAQPage',
  '@id': `${serviceUrl}#faq`,
  inLanguage: 'id-ID',
  mainEntity: faqBlock.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;

const serviceSchemaJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${serviceUrl}#service`,
      name: data.title,
      description: data.intro ?? data.description,
      url: serviceUrl,
      ...(pageImageUrl ? { image: pageImageUrl } : {}),
      provider: { '@id': `${origin}/#organization` },
      areaServed: site.areaServed.map((area) => ({ '@type': 'Country', name: area })),
    },
    ...(faqJsonLd ? [faqJsonLd] : []),
  ],
}).replace(/</g, '\\u003c');

const otherServices = (await getCollection('services'))
  .filter((entry) => !entry.data.draft && entry.data.status === 'active' && entry.data.slug !== data.slug)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    href: `/services/${entry.data.slug}/`,
    title: entry.data.title,
    description: entry.data.description,
    group: entry.data.serviceGroup,
  }));
---

<ServiceLayout
  title={data.title}
  description={data.description}
  socialImage={data.socialImage ?? data.image}
  canonical={data.canonical}
  noindex={data.noindex}
  pubDate={data.pubDate}
  updatedDate={data.updatedDate}
  mainEntityId={faqJsonLd ? `${serviceUrl}#faq` : `${serviceUrl}#service`}
  serviceUrl={serviceUrl}
  serviceName={data.title}
  serviceDescription={data.intro ?? data.description}
  serviceImage={data.image ?? data.socialImage}
>
  <script type="application/ld+json" set:html={serviceSchemaJsonLd} slot="head" />

  <SiteHeader />

  <main id="main-content" class="service-page">
    <section class="service-hero" aria-labelledby="service-title">
      {pageImage && (
        <div class="service-hero__media" aria-hidden="true">
          <img src={pageImage} alt="" fetchpriority="high" decoding="async" />
        </div>
      )}
      <div class="wrap service-hero__inner">
        <nav class="service-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Beranda</a></li>
            <li><a href="/services/">Layanan</a></li>
            <li aria-current="page">{data.title}</li>
          </ol>
        </nav>

        <div class="service-hero__content">
          <p class="service-hero__eyebrow">{data.eyebrow ?? ui.services.defaultEyebrow}</p>
          <h1 id="service-title">{data.title}</h1>
          <p class="service-hero__lead">{data.intro ?? data.description}</p>
          <div class="service-hero__actions">
            <a class="btn btn-gold" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Halo, saya ingin mendapatkan informasi tentang ${data.title}.`)}`} target="_blank" rel="noopener noreferrer">
              <svg aria-hidden="true"><use href="#i-wa" /></svg>
              Konsultasi Program
            </a>
            <a class="service-hero__text-link" href="#service-content">Pelajari program <span aria-hidden="true">↓</span></a>
          </div>
          <p class="service-hero__trust">Program pelatihan K3 ruang terbatas · Informasi dan konsultasi untuk perusahaan maupun peserta individu</p>
        </div>
      </div>
    </section>

    <section class="service-body section" id="service-content" aria-label="Informasi layanan">
      <div class="wrap service-body__layout">
        {navigationItems.length > 1 && (
          <aside class="service-toc" aria-label="Navigasi isi halaman">
            <p class="service-toc__title">Di halaman ini</p>
            <nav>
              <ul>
                {navigationItems.map((item) => (
                  <li><a href={`#${item.id}`}>{item.label}</a></li>
                ))}
              </ul>
            </nav>
            <a class="service-toc__contact" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">
              Butuh informasi?
              <span>Hubungi tim kami <span aria-hidden="true">↗</span></span>
            </a>
          </aside>
        )}

        <div class="service-content">
          {data.blocks.map((block) => (
            <div class={`service-content__block service-content__block--${block.component}`}>
              <BlockRenderer block={block} />
            </div>
          ))}
        </div>
      </div>
    </section>

    {otherServices.length > 0 && (
      <section class="service-related section" aria-labelledby="other-programs-title">
        <div class="wrap">
          <header class="section-title">
            <p class="section-label">{ui.services.listingEyebrow}</p>
            <h2 id="other-programs-title">{ui.services.otherProgramsHeading}</h2>
            <p>Kenali program pembinaan K3 ruang terbatas lainnya sesuai peran dan kebutuhan pekerjaan Anda.</p>
          </header>
          <ul class="service-related__grid" role="list">
            {otherServices.map((program) => (
              <li>
                <article class="service-related-card">
                  <p class="service-related-card__group">{program.group}</p>
                  <h3>{program.title}</h3>
                  <p class="service-related-card__description">{program.description}</p>
                  <a href={program.href} class="service-related-card__link">
                    Lihat detail layanan <span aria-hidden="true">→</span>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="service-final-cta section" aria-labelledby="service-cta-title">
      <div class="wrap">
        <div class="service-final-cta__panel">
          <div>
            <p class="section-label">{ui.ctaBlock.eyebrow}</p>
            <h2 id="service-cta-title">{ui.ctaBlock.heading}</h2>
            <p>{ui.ctaBlock.text}</p>
          </div>
          <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Halo, saya ingin berkonsultasi mengenai ${data.title}.`)}`} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true"><use href="#i-wa" /></svg>
            {ui.ctaBlock.defaultButton}
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter serviceTitle={data.title} group={data.serviceGroup} />
</ServiceLayout>
