---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { howToJsonLd } from '../utils/howto.ts';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { site } from '../config/site.ts';
import ArticlePreviousArticles from '../components/shared/ArticlePreviousArticles.astro';
import { ui } from '../config/ui.ts';
import '../styles/global.css';
const { article, headings = [] } = Astro.props as {
  article: CollectionEntry<'articles'>;
  headings?: Array<{ depth: number; text: string; slug: string }>;
};
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const articles = await getCollection('articles');
const hasPreviousArticles = articles.some((item) => !item.data.draft && item.data.contentType !== 'local-seo' && item.data.id < article.data.id);
const pageTitle = article.data.title;
const description = article.data.description;
const canonical = `/articles/${article.data.slug}/`;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const articleUrl = new URL(canonical, siteUrl).toString();
// Foto utama artikel: featuredImage > socialImage > default. Dipakai untuk halaman, OG/Twitter, dan JSON-LD.
const articleImageSource = article.data.featuredImage ?? article.data.socialImage ?? ui.meta.articleImage;
const isRasterArticleImage = /\.(png|jpe?g|webp|gif)$/i.test(articleImageSource.split(/[?#]/)[0]);
const articleImage = new URL(isRasterArticleImage ? articleImageSource : ui.meta.defaultImage, siteUrl).toString();
const articleImageAlt = article.data.featuredImageAlt ?? pageTitle;

const authorName = typeof article.data.author === 'object' ? article.data.author.name : article.data.author;
const authorUrl = typeof article.data.author === 'object' ? article.data.author.url : undefined;
const authorType = typeof article.data.author === 'object' ? article.data.author.type : 'Person';

const services = await getCollection('services');
const relatedServiceIds = [...new Set([
  ...(article.data.relatedServices ?? []),
  ...(article.data.relatedType === 'service' && article.data.relatedId ? [article.data.relatedId] : []),
])];
const relatedServices = relatedServiceIds
  .map((id) => services.find((service) => service.data.id === id))
  .filter((service) => service && !service.data.draft && service.data.status === 'active');
const footerServiceTitles = relatedServices.map((service) => service!.data.title);
const relatedServiceLinks = relatedServices.map((service) => ({
  title: service!.data.title,
  href: `/services/${service!.data.slug}/`,
}));
const relatedServiceHref = relatedServiceLinks[0]?.href ?? '/services/';
const articleCtaText = relatedServiceLinks.length
  ? `Pelajari layanan ${footerServiceTitles.join(', ')} dan diskusikan kebutuhan Anda bersama tim kami.`
  : ui.article.ctaText;
const articleCtaButton = relatedServiceLinks.length ? 'Lihat layanan terkait' : ui.article.ctaButton;
const relatedServiceJsonLd = relatedServices.map((related) => {
  const relServiceUrl = new URL(`/services/${related.data.slug}/`, siteUrl).toString();
  const relServiceImageSource = related.data.socialImage ?? ui.meta.defaultImage;
  const relIsRasterImage = /\.(png|jpe?g|webp|gif)$/i.test(relServiceImageSource.split(/[?#]/)[0]);
  const relServiceImage = new URL(relIsRasterImage ? relServiceImageSource : ui.meta.defaultImage, siteUrl).toString();
  return {
    '@type': 'Service',
    '@id': `${relServiceUrl}#service`,
    name: related.data.title,
    description: related.data.description,
    image: [relServiceImage],
    url: relServiceUrl,
    provider: { '@id': `${siteUrl}/#organization` },
    ...(article.data.serviceArea ? { areaServed: article.data.serviceArea } : {}),
  };
});
const buildingTypesBlock = article.data.blocks.find((block) => block.component === 'card' && block.id === 'kategori-bangunan-slf');
const buildingTypesList = buildingTypesBlock && 'body' in buildingTypesBlock ? buildingTypesBlock.body.find((item): item is Extract<typeof item, { type: 'list' }> => item.type === 'list') : null;
const buildingTypesJsonLd = buildingTypesBlock && 'heading' in buildingTypesBlock && buildingTypesList ? {
  '@type': 'ItemList',
  '@id': `${articleUrl}#kategori-bangunan-slf`,
  name: buildingTypesBlock.heading ?? 'Contoh jenis bangunan',
  description: 'Contoh jenis bangunan yang dapat memerlukan peninjauan kebutuhan dan dokumen terkait SLF.',
  itemListOrder: 'https://schema.org/ItemListUnordered',
  numberOfItems: buildingTypesList.items.length,
  itemListElement: buildingTypesList.items.map((name: string, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    name,
  })),
} : null;
const faqBlock = article.data.blocks.find((block) => block.component === 'faq');
const faqJsonLd = faqBlock && 'items' in faqBlock ? {
  '@type': 'FAQPage',
  '@id': `${articleUrl}#faq`,
  inLanguage: 'id-ID',
  mainEntity: faqBlock.items.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

// Galeri: ImageGallery schema.org untuk setiap block gallery
const galleryBlocks = article.data.blocks.filter((block) => block.component === 'gallery');
const galleryJsonLd = galleryBlocks.map((block, index) => {
  const blockId = block.id ?? `gallery-${index + 1}`;
  const items = 'items' in block ? block.items : [];
  const imageObjects = items.map((item: { src: string; alt: string; caption?: string }) => {
    const imageUrl = new URL(item.src, siteUrl).toString();
    const caption = item.caption ?? item.alt;
    return {
      '@type': 'ImageObject',
      url: imageUrl,
      ...(caption ? { caption } : {}),
    };
  });
  return {
    '@type': 'ImageGallery',
    '@id': `${articleUrl}#${blockId}`,
    name: block.heading ?? `Galeri ${index + 1}`,
    ...(block.intro ? { description: block.intro } : {}),
    ...(imageObjects.length ? { image: imageObjects } : {}),
  };
});

// HowTo opsional: dirakit dari blok prosedural (steps/process-timeline) yang dirujuk frontmatter `howTo`.
const howToNode = article.data.howTo ? howToJsonLd({
  pageUrl: articleUrl,
  name: article.data.howTo.name ?? pageTitle,
  description: article.data.howTo.description ?? description,
  howTo: article.data.howTo,
  blocks: article.data.blocks,
}) : null;

const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const articleJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': article.data.schemaType,
      '@id': `${articleUrl}#article`,
      headline: pageTitle,
      description,
      inLanguage: 'id-ID',
      image: [articleImage],
      datePublished: utcIso(article.data.pubDate),
      ...(article.data.updatedDate ? { dateModified: utcIso(article.data.updatedDate) } : {}),
      ...(authorName ? { author: { '@type': authorType, name: authorName, url: authorUrl ?? siteUrl } } : {}),
      publisher: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: ui.brand.name,
        url: siteUrl,
        ...(article.data.serviceArea ? { areaServed: article.data.serviceArea } : {}),
      },

      ...(relatedServiceJsonLd.length ? { about: relatedServiceJsonLd.map((service) => ({ '@id': service['@id'] })) } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': `${articleUrl}#webpage` },
      url: articleUrl,
    },
    ...relatedServiceJsonLd,
    ...(buildingTypesJsonLd ? [buildingTypesJsonLd] : []),
    ...(faqJsonLd ? [faqJsonLd] : []),
    ...galleryJsonLd,
    ...(howToNode ? [howToNode] : [])
  ]
}).replace(/</g, '\\u003c');
---
<BaseLayout title={pageTitle} description={description} canonical={canonical} socialImage={article.data.featuredImage ?? article.data.socialImage ?? ui.meta.articleImage} imageAlt={articleImageAlt} pubDate={article.data.pubDate} updatedDate={article.data.updatedDate} mainEntityId={`${articleUrl}#article`}>
  <script slot="head" type="application/ld+json" set:html={articleJsonLd}></script>
  <meta slot="head" property="article:published_time" content={utcIso(article.data.pubDate)} />
  {article.data.updatedDate && <meta slot="head" property="article:modified_time" content={utcIso(article.data.updatedDate)} />}
  {authorName && <meta slot="head" property="article:author" content={authorName} />}
    <SiteHeader />
  <main id="main-content" class="article-layout mx-auto grid w-full max-w-[1440px] grid-cols-1 gap-8 px-5 py-8 lg:grid-cols-[280px_minmax(0,1fr)] lg:gap-10 lg:px-8 lg:py-12">
    {(tocItems.length > 0 || hasPreviousArticles) && (
      <aside class="article-sidebar self-start lg:sticky lg:top-6">
        {tocItems.length > 0 && <details class="rounded-xl border border-slate-200 p-4 lg:hidden">
          <summary class="cursor-pointer font-semibold text-slate-800">{ui.article.tocMobile}</summary>
          <nav class="mt-3" aria-label={ui.article.tocAriaLabel}>
            <ul class="space-y-2 pl-4 text-sm">
              {tocItems.map((item) => <li class={item.depth === 3 ? 'ml-4' : ''}><a class="text-slate-600 hover:text-blue-700" href={`#${item.slug}`}>{item.text}</a></li>)}
            </ul>
          </nav>
        </details>}
        {tocItems.length > 0 && <nav class="article-toc hidden lg:block" aria-label={ui.article.tocAriaLabel}>
          <p class="article-toc__title">{ui.article.tocTitle}</p>
          <ul class="article-toc__list">
            {tocItems.map((item) => <li class:list={['article-toc__item', item.depth === 3 && 'article-toc__item--nested']}><a href={`#${item.slug}`}>{item.text}</a></li>)}
          </ul>
        </nav>}
        <ArticlePreviousArticles article={article} articles={articles} />
      </aside>
    )}
    <article class="article-content prose-content min-w-0">
      <header class="article-content__header border-b border-slate-200 pb-7">
        {article.data.category && <p class="text-xs font-bold uppercase tracking-wider text-blue-700">{article.data.category}</p>}
        <h1 class="article-content__title mt-2 font-extrabold text-slate-950">{pageTitle}</h1>
        <p class="article-content__description mt-4 text-slate-600">{description}</p>
        <img src={article.data.featuredImage ?? article.data.image ?? ui.article.defaultImage} alt={articleImageAlt} class="mt-6 w-full max-w-2xl rounded-2xl object-cover" width="1600" height="1067" fetchpriority="high" />
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-500">
          <time datetime={utcIso(article.data.pubDate)}>{article.data.pubDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</time>
          {article.data.updatedDate && <span>{ui.article.updatedPrefix} {article.data.updatedDate.toLocaleDateString(ui.locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Jakarta' })}</span>}
          {authorName && (
            <span>
              {ui.article.authorPrefix}{' '}
              {authorUrl ? (
                <a href={authorUrl} target="_blank" rel="noopener noreferrer" class="text-slate-500 underline decoration-slate-300 underline-offset-4 transition hover:text-blue-700 hover:decoration-blue-700">
                  {authorName}
                </a>
              ) : (
                authorName
              )}
            </span>
          )}
        </div>
      </header>
      <div class="prose-content [&>h2]:scroll-mt-24 [&>h3]:scroll-mt-24"><slot /></div>
      <slot name="related" />
    </article>
  </main>
  <section id="article-cta" class="article-footer-cta border-t border-slate-200">
    <div class="article-footer-cta__inner mx-auto max-w-[1440px] px-5 py-12 lg:px-8 lg:py-16">
      <div>
        <h2 class="article-footer-cta__title">{ui.article.ctaHeading}</h2>
        <p class="article-footer-cta__description">{articleCtaText}</p>
      </div>
      <div class="article-footer-cta__actions">
        {relatedServiceLinks.length ? relatedServiceLinks.map((service) => <a href={service.href} class="article-footer-cta__service-link">{service.title}</a>) : <a href={relatedServiceHref} class="article-footer-cta__service-link">{articleCtaButton}</a>}
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer" class="article-footer-cta__whatsapp">{ui.ctaBlock.defaultButton}</a>
      </div>
    </div>
  </section>
    <SiteFooter serviceTitles={footerServiceTitles} />
</BaseLayout>
