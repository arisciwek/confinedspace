---
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site.ts';
import { ui } from '../config/ui.ts';

interface Props {
  title: string;
  description: string;
  socialImage?: string;
  canonical?: string;
  noindex?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  mainEntityId?: string;
  aboutId?: string;
  serviceUrl: string;
  serviceName: string;
  serviceDescription: string;
  serviceImage?: string;
}

const {
  title,
  description,
  socialImage,
  canonical,
  noindex = false,
  pubDate,
  updatedDate,
  mainEntityId,
  aboutId,
  serviceUrl,
  serviceName,
  serviceDescription,
  serviceImage,
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const profServiceId = `${serviceUrl}#professionalservice`;

// ProfessionalService khusus halaman ini (bukan site-wide)
const serviceProfJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': profServiceId,
  name: serviceName,
  legalName: site.name,
  description: serviceDescription,
  url: serviceUrl,
  image: serviceImage ? new URL(serviceImage, siteOrigin).toString() : new URL(site.logo, siteOrigin).toString(),
  logo: { '@type': 'ImageObject', url: new URL(site.logo, siteOrigin).toString() },
  telephone: `+${site.phone}`,
  email: site.email,
  priceRange: 'Rp6.000.000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.street}, Kelurahan ${site.address.village}`,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    postalCode: site.address.postalCode,
    addressCountry: site.address.countryCode,
  },
  areaServed: site.areaServed.map((area) => ({ '@type': 'Country', name: area })),
  parentOrganization: { '@id': `${siteOrigin}/#organization` },
}).replace(/</g, '\\u003c');
---

<BaseLayout
  title={title}
  description={description}
  socialImage={socialImage}
  canonical={canonical}
  noindex={noindex}
  pubDate={pubDate}
  updatedDate={updatedDate}
  mainEntityId={mainEntityId}
  aboutId={aboutId}
  serviceUrl={serviceUrl}
  skipProfessionalService={true}
>
  <script type="application/ld+json" set:html={serviceProfJsonLd} slot="head" />
  <slot name="head" />
  <slot />
</BaseLayout>