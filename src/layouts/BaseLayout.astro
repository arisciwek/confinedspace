---
import '../styles/global.css';
import { ui } from '../config/ui.ts';
import { site } from '../config/site.ts';
const { title = ui.meta.defaultTitle, description = ui.meta.defaultDescription, canonical, noindex = false, socialImage = ui.meta.defaultImage, pubDate, updatedDate, mainEntityId, aboutId } = Astro.props as { title?: string; description?: string; canonical?: string; noindex?: boolean; socialImage?: string; pubDate?: Date; updatedDate?: Date; mainEntityId?: string; aboutId?: string };
// Crawler sosial (Facebook, LinkedIn, WhatsApp, X) tidak merender SVG. Gambar non-raster diganti fallback WebP.
const isRasterImage = /\.(png|jpe?g|webp|gif)$/i.test(socialImage.split(/[?#]/)[0]);
const resolvedSocialImage = isRasterImage ? socialImage : ui.meta.defaultImage;
const imageAlt = isRasterImage ? (Astro.props.imageAlt ?? title) : ui.meta.socialImageAlt;
const utcIso = (date: Date) => date.toISOString().replace(/\.\d{3}Z$/, 'Z');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const siteOrigin = siteUrl || Astro.url.origin;
const canonicalUrl = canonical ? new URL(canonical, siteUrl || Astro.url).toString() : new URL(Astro.url.pathname, siteUrl || Astro.url).toString();
const imageUrl = resolvedSocialImage.startsWith('http') ? resolvedSocialImage : new URL(resolvedSocialImage, siteUrl || Astro.url).toString();
// Build one canonical BreadcrumbList for every route using this layout.
const pathname = new URL(canonicalUrl).pathname.replace(/\/+$/, '') || '/';
const pathSegments = pathname.split('/').filter(Boolean);
const breadcrumbLabels: Record<string, string> = {
  articles: ui.nav.articles,
  services: ui.nav.services,
  kontak: ui.nav.contact,
};
const breadcrumbItems = [{ name: ui.nav.home, url: new URL('/', siteUrl || Astro.url).toString() }];
if (pathSegments.length > 0) {
  let accumulatedPath = '';
  for (let index = 0; index < pathSegments.length; index += 1) {
    const segment = pathSegments[index];
    accumulatedPath += `/${segment}`;
    const isLast = index === pathSegments.length - 1;
    const name = isLast
      ? title
      : breadcrumbLabels[segment] ?? segment.replace(/-/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase());
    breadcrumbItems.push({
      name,
      url: new URL(`${accumulatedPath}/`, siteUrl || Astro.url).toString(),
    });
  }
} else {
  breadcrumbItems[0] = { name: title, url: canonicalUrl };
}
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
}).replace(/</g, '\\u003c');
const pageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  name: title,
  description,
  inLanguage: 'id-ID',
  ...(pubDate ? { datePublished: utcIso(pubDate) } : {}),
  ...(updatedDate ? { dateModified: utcIso(updatedDate) } : {}),
  url: canonicalUrl,
  ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
  ...(aboutId ? { about: { '@id': aboutId } } : {}),
  isPartOf: { '@id': `${siteOrigin}/#website` },
}).replace(/</g, '\\u003c');
const logoUrl = site.logo.startsWith('http') ? site.logo : new URL(site.logo, siteOrigin).toString();
const siteGraphJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}/#organization`,
      name: site.name,
      alternateName: site.alternateName,
      url: siteOrigin,
      description: site.description,
      email: site.email,
      logo: { '@type': 'ImageObject', url: new URL(site.logo, siteOrigin).toString() },
      telephone: `+${site.phone}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, Kelurahan ${site.address.village}`,
        addressLocality: site.address.city,
        addressRegion: site.address.province,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      sameAs: site.social.map((item) => item.href),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      name: ui.meta.defaultTitle,
      url: siteOrigin,
      inLanguage: ui.locale,
      publisher: { '@id': `${siteOrigin}/#organization` },
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteOrigin}/#localbusiness`,
      name: site.name,
      legalName: site.name,
      description: site.description,
      url: siteOrigin,
      image: new URL(site.logo, siteOrigin).toString(),
      logo: { '@type': 'ImageObject', url: new URL(site.logo, siteOrigin).toString() },
      telephone: `+${site.phone}`,
      email: site.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${site.address.street}, Kelurahan ${site.address.village}`,
        addressLocality: site.address.city,
        addressRegion: site.address.province,
        postalCode: site.address.postalCode,
        addressCountry: site.address.countryCode,
      },
      areaServed: site.areaServed.map((area) => ({ '@type': 'Country', name: area })),
      parentOrganization: { '@id': `${siteOrigin}/#organization` },
    },
  ],
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#081B33" />
    <link rel="icon" type="image/png" href="/images/logo-betracom.png" />
    <link rel="apple-touch-icon" href="/images/logo-betracom.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {pubDate && <meta name="datePublished" content={utcIso(pubDate)} />}
    {updatedDate && <meta name="dateModified" content={utcIso(updatedDate)} />}
    <script type="application/ld+json" set:html={siteGraphJsonLd}></script>
    <script type="application/ld+json" set:html={pageJsonLd}></script>
    <script type="application/ld+json" set:html={breadcrumbJsonLd}></script>
    {noindex ? null : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={Astro.url.pathname.startsWith('/articles/') && Astro.url.pathname !== '/articles/' ? 'article' : 'website'} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={ui.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-3 focus:font-bold focus:text-slate-950 focus:shadow-lg focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-blue-700">{ui.a11y.skipToContent}</a>
    <slot />
  </body>
</html>
