---
/**
 * ChecklistCard — editorial checklist for safety and readiness reviews.
 * Required items are labelled as mandatory; this component is informational,
 * not an interactive form or a confirmation of actual compliance.
 */
const { id, title, description, items, note } = Astro.props;
---
<section id={id} class="checklist-card" aria-labelledby={`${id}-title`}>
  <header class="checklist-card__header">
    <span class="checklist-card__icon" aria-hidden="true">✓</span>
    <div class="checklist-card__intro">
      <h2 id={`${id}-title`} class="checklist-card__title">{title}</h2>
      {description && <p class="checklist-card__description">{description}</p>}
    </div>
  </header>
  <ul class="checklist-card__list">
    {items.map((item: {label: string; detail?: string; required?: boolean}) => (
      <li class="checklist-card__item">
        <span class="checklist-card__item-icon" aria-hidden="true">✓</span>
        <div class="checklist-card__item-copy">
          <p class="checklist-card__item-title">{item.label}</p>
          {item.detail && <p class="checklist-card__item-detail">{item.detail}</p>}
        </div>
        {item.required && <span class="checklist-card__badge">Wajib</span>}
      </li>
    ))}
  </ul>
  {note && <p class="checklist-card__note">{note}</p>}
</section>
