---
const { id, title, columns = 3, items } = Astro.props as { id: string; title: string; columns?: 2 | 3; items: { title: string; description?: string; points?: string[] }[] };
const titleId = `${id}-title`;
---
<section id={id} class:list={['feature-grid-block', `feature-grid-block--${columns}`]} aria-labelledby={titleId}>
  <h2 id={titleId} class="feature-grid-block__heading">{title}</h2>
  <div class="feature-grid-block__grid">
    {items.map((item) => <article class="feature-grid-card">
      <h3 class="feature-grid-card__title">{item.title}</h3>
      {item.description && <p class="feature-grid-card__description">{item.description}</p>}
      {item.points?.length && <ul class="feature-grid-card__points">{item.points.map((point) => <li>{point}</li>)}</ul>}
    </article>)}
  </div>
</section>
