---
/**
 * ArticleGallery — thumbnail grid + native <dialog> lightbox (no plugin).
 * Thumbnails stay small so the gallery fits inside the article body;
 * clicking a photo opens a full-size slide with prev/next navigation.
 */
import { ui } from '../../config/ui.ts';

interface GalleryItem {
  src: string;
  thumb?: string;
  alt: string;
  caption?: string;
}

interface Props {
  id: string;
  heading?: string;
  intro?: string;
  items: GalleryItem[];
}

const { id, heading, intro, items } = Astro.props;
const dialogId = `${id}-dialog`;
const titleId = `${id}-title`;
const count = items.length;
---

<section class="article-gallery" id={id} aria-labelledby={heading ? titleId : undefined}>
  {heading && <h2 id={titleId}>{heading}</h2>}
  {intro && <p class="article-gallery__intro">{intro}</p>}

  <ul class:list={['article-gallery__grid', `article-gallery__grid--${count}`]} role="list">
    {items.map((item, index) => (
      <li>
        <button
          type="button"
          class="article-gallery__thumb"
          data-gallery-open={dialogId}
          data-gallery-index={index}
          aria-label={`${ui.gallery.openLabel} ${index + 1}: ${item.alt}`}
        >
          <img src={item.thumb ?? item.src} alt={item.alt} width="480" height="360" loading="lazy" decoding="async" />
        </button>
      </li>
    ))}
  </ul>
</section>

<dialog
  id={dialogId}
  class="article-gallery__dialog"
  data-gallery-dialog
  data-counter-label={ui.gallery.counterLabel}
  data-of-label={ui.gallery.ofLabel}
  aria-label={heading ?? ui.gallery.ariaLabel}
>
  <div class="article-gallery__dialog-inner" data-gallery-inner>
    <button type="button" class="article-gallery__close" data-gallery-close aria-label={ui.gallery.closeLabel}>
      <span aria-hidden="true">×</span>
    </button>

    <button type="button" class="article-gallery__nav article-gallery__nav--prev" data-gallery-prev aria-label={ui.gallery.prevLabel}>
      <span aria-hidden="true">‹</span>
    </button>

    <div class="article-gallery__track" data-gallery-track>
      {items.map((item) => (
        <figure class="article-gallery__slide" data-gallery-slide>
          <img src={item.src} alt={item.alt} width="1600" height="1067" loading="lazy" decoding="async" />
          <figcaption>{item.caption ?? item.alt}</figcaption>
        </figure>
      ))}
    </div>

    <button type="button" class="article-gallery__nav article-gallery__nav--next" data-gallery-next aria-label={ui.gallery.nextLabel}>
      <span aria-hidden="true">›</span>
    </button>

    <p class="article-gallery__counter" data-gallery-counter aria-live="polite">
      {ui.gallery.counterLabel} 1 {ui.gallery.ofLabel} {count}
    </p>
  </div>
</dialog>

<script>
  const galleries = document.querySelectorAll<HTMLDialogElement>('[data-gallery-dialog]');

  galleries.forEach((dialog) => {
    if (dialog.dataset.bound === 'true') return;
    dialog.dataset.bound = 'true';

    const inner = dialog.querySelector<HTMLElement>('[data-gallery-inner]');
    const track = dialog.querySelector<HTMLElement>('[data-gallery-track]');
    const slides = Array.from(dialog.querySelectorAll<HTMLElement>('[data-gallery-slide]'));
    const counter = dialog.querySelector<HTMLElement>('[data-gallery-counter]');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]');
    const close = dialog.querySelector<HTMLButtonElement>('[data-gallery-close]');
    const counterLabel = dialog.dataset.counterLabel ?? 'Foto';
    const ofLabel = dialog.dataset.ofLabel ?? 'dari';
    let index = 0;

    const setCounter = (value: number) => {
      index = Math.max(0, Math.min(slides.length - 1, value));
      if (counter) counter.textContent = `${counterLabel} ${index + 1} ${ofLabel} ${slides.length}`;
      prev?.toggleAttribute('disabled', index === 0);
      next?.toggleAttribute('disabled', index === slides.length - 1);
    };

    const scrollToSlide = (behavior: ScrollBehavior = 'smooth') => {
      const slide = slides[index];
      if (track && slide) track.scrollTo({ left: slide.offsetLeft, behavior });
    };

    const goTo = (value: number, behavior: ScrollBehavior = 'smooth') => {
      setCounter(value);
      scrollToSlide(behavior);
    };

    close?.addEventListener('click', () => dialog.close());
    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === inner) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      }
    });

    track?.addEventListener(
      'scroll',
      () => {
        if (!track) return;
        const current = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
        if (current !== index) setCounter(current);
      },
      { passive: true }
    );

    dialog.addEventListener('close', () => goTo(0, 'auto'));
    dialog.addEventListener('gallery:open', (event) => {
      const detail = (event as CustomEvent<{ index: number }>).detail;
      goTo(detail?.index ?? 0, 'auto');
    });

    setCounter(0);
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLElement>('[data-gallery-open]');
    if (!trigger) return;

    const dialogId = trigger.dataset.galleryOpen;
    const dialog = dialogId ? document.getElementById(dialogId) : null;
    if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;

    const start = Number(trigger.dataset.galleryIndex ?? 0);
    dialog.showModal();
    dialog.dispatchEvent(new CustomEvent('gallery:open', { detail: { index: start } }));
  });
</script>
