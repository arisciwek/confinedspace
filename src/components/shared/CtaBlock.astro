---
import { site } from '../../config/site.ts';
import { ui } from '../../config/ui.ts';
const { id, heading, message, button = ui.ctaBlock.defaultButton, serviceHref, serviceLabel = button, class: css } = Astro.props;
const hasWhatsapp = /^\d{8,15}$/.test(site.whatsapp);
const whatsappHref = hasWhatsapp ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(message)}` : undefined;
---
<section id={id} class={`cta-content-block ${css?.section ?? ''}`} aria-labelledby={heading ? `${id}-title` : undefined}>
  <div class="cta-content-block__copy">
    {heading && <h2 id={`${id}-title`} class={`cta-content-block__heading ${css?.heading ?? ''}`}>{heading}</h2>}
    <p class={`cta-content-block__message ${css?.message ?? ''}`}>{message}</p>
  </div>
  <div class="cta-content-block__actions">
    {serviceHref && <a href={serviceHref} class={`cta-content-block__secondary ${css?.button ?? ''}`}>{serviceLabel}</a>}
    {whatsappHref ? <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class={`cta-content-block__button ${css?.button ?? ''}`}>{button}</a> : <p class="cta-content-block__missing">{ui.ctaBlock.whatsappMissing}</p>}
  </div>
</section>
