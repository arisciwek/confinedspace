---
import { ui } from '../../config/ui.ts';
const { id, variant = 'info', title, text, class: css } = Astro.props;
const variants: Record<string, string> = {
  info: 'note-block--info',
  success: 'note-block--success',
  warning: 'note-block--warning',
  danger: 'note-block--danger',
};
const variantClass = variants[variant] ?? variants.info;
---
<aside id={id} class={`note-block ${variantClass} ${css?.section ?? ''}`} aria-label={title ?? ui.blocks.noteDefaultTitles[variant] ?? variant}>
  <span class="note-block__marker" aria-hidden="true">!</span>
  <div class="note-block__body">
    <h3 class={`note-block__title ${css?.title ?? ''}`}>{title ?? ui.blocks.noteDefaultTitles[variant] ?? variant}</h3>
    <p class={`note-block__text ${css?.text ?? ''}`}>{text}</p>
  </div>
</aside>
