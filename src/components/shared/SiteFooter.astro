---
import { ui } from '../../config/ui.ts';
import { site } from '../../config/site.ts';

export interface Props {
  ariaLabel?: string;
  serviceTitle?: string;
  group?: string;
}
const { ariaLabel = ui.nav.footerAriaLabel, serviceTitle, group } = Astro.props;
const year = new Date().getFullYear();

// Tagline footer: jika ada serviceTitle, tampilkan "PT Betracom Gemilang Nusa Menyediakan Pelatihan dan Sertifikasi <serviceTitle>"
const cleanTitle = serviceTitle?.replace(/^Pelatihan\s+/i, '') ?? '';
const footerTagline = serviceTitle
  ? `PT ${site.name.replace(/^PT\s+/i, '')} Menyediakan Pelatihan dan Sertifikasi ${cleanTitle}`
  : 'Lembaga pelatihan dan sertifikasi K3 terakreditasi Kemnaker RI & BNSP, melayani perusahaan dan individu di seluruh Indonesia.';
const socialIcon: Record<string, string> = {
  LinkedIn:
    'M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.68H9.35V8.99h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.48v6.27ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM3.56 20.45h3.56V8.99H3.56v11.46Z',
  Instagram:
    'M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.97.24 2.43.4a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.16.46.35 1.26.4 2.43.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.97-.4 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.46.16-1.26.35-2.43.4-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.97-.24-2.43-.4a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.16-.46-.35-1.26-.4-2.43C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.24-1.97.4-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.59 1.8c.46-.16 1.26-.35 2.43-.4C9.29 1.34 9.67 1.33 12 1.33Zm0 1.8c-3.15 0-3.5.01-4.74.07-.96.04-1.48.2-1.82.34-.46.18-.78.39-1.13.74-.35.35-.56.67-.74 1.13-.14.34-.3.86-.34 1.82C3.16 8.14 3.15 8.49 3.15 12s.01 3.86.07 5.1c.04.96.2 1.48.34 1.82.18.46.39.78.74 1.13.35.35.67.56 1.13.74.34.14.86.3 1.82.34 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.96-.04 1.48-.2 1.82-.34.46-.18.78-.39 1.13-.74.35-.35.56-.67.74-1.13.14-.34.3-.86.34-1.82.06-1.24.07-1.59.07-5.1s-.01-3.86-.07-5.1c-.04-.96-.2-1.48-.34-1.82a3.1 3.1 0 0 0-.74-1.13 3.1 3.1 0 0 0-1.13-.74c-.34-.14-.86-.3-1.82-.34-1.24-.06-1.59-.07-4.74-.07Zm0 4.05a4.95 4.95 0 1 1 0 9.9 4.95 4.95 0 0 1 0-9.9Zm0 8.16a3.21 3.21 0 1 0 0-6.42 3.21 3.21 0 0 0 0 6.42Zm5.15-8.36a1.16 1.16 0 1 1-2.31 0 1.16 1.16 0 0 1 2.31 0Z',
  YouTube:
    'M22 8.03s-.22-1.55-.9-2.24c-.86-.9-1.83-.9-2.27-.96C15.7 4.6 12 4.6 12 4.6h-.01s-3.7 0-6.83.23c-.44.06-1.41.06-2.27.96C2.22 6.48 2 8.03 2 8.03S1.78 9.85 1.78 11.66v1.7c0 1.82.22 3.63.22 3.63s.22 1.55.9 2.24c.86.9 1.98.87 2.48.97 1.8.17 7.62.23 7.62.23s3.7 0 6.83-.24c.44-.06 1.41-.06 2.27-.96.68-.7.9-2.24.9-2.24s.22-1.82.22-3.63v-1.7C22.22 9.85 22 8.03 22 8.03ZM9.98 15.02V8.9l5.7 3.07-5.7 3.05Z',
  TikTok:
    'M16.6 2h-3.2v13.7a2.9 2.9 0 1 1-2.05-2.77v-3.3a6.13 6.13 0 1 0 5.25 6.07V8.9a7.8 7.8 0 0 0 4.6 1.5V7.2a4.55 4.55 0 0 1-4.6-4.55V2Z',
};
const isExternal = (href: string) => href.startsWith('http');
---
<footer class="site-footer" role="contentinfo">
  <div class="footer-media" aria-hidden="true">
    <img src="/images/footer-bg.webp" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="wrap footer-top">
    <div class="footer-col footer-col-brand">
      <div class="footer-brand">
        {site.logo && (
          <img class="brand-logo" src={site.logo} alt={ui.brand.logoAlt} loading="lazy" decoding="async" width="60" height="60" />
        )}
        <span>{ui.brand.wordMain}<br />{ui.brand.wordSub}</span>
      </div>
      <p class="footer-desc">{footerTagline}</p>

      <ul class="footer-social" aria-label={ui.footer.socialLabel}>
        {site.social.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label} (tab baru)`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={socialIcon[item.name]} fill="currentColor" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav class="footer-col footer-col-nav" aria-labelledby="footer-nav-title">
      <h2 class="footer-title" id="footer-nav-title">{ui.footer.navTitle}</h2>
      <ul class="footer-links">
        {ui.nav.items.footer.map((item) => (
          <li>
            <a
              href={item.href}
              class="no-underline"
              {...(isExternal(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer-col footer-col-contact">
      <h2 class="footer-title">{ui.footer.contactTitle}</h2>
      <address class="footer-contact">
        <p class="footer-contact-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" fill="currentColor"/></svg>
          <span><strong>{site.venue}</strong><br />{site.address.full}</span>
        </p>
        <p class="footer-contact-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8Z" fill="currentColor"/></svg>
          <a href={`tel:+${site.phone}`}>{site.phoneDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.5 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3.1.8.8-3-.2-.3a8.2 8.2 0 1 1 7 3.9Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp {site.whatsappDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm15.4 2H4.6l7.4 6.2L19.4 6ZM3 7.4V18h18V7.4l-8.4 7-8.6-7Z" fill="currentColor"/></svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </address>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; <span class="year">{year}</span> {site.name}. Seluruh hak cipta dilindungi.</p>
  </div>
</footer>
