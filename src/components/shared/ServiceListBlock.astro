---
import { getCollection } from 'astro:content';
import { ui } from '../../config/ui.ts';
const { id, eyebrow, heading, description, variant = 'listing', columns = 3, showBenefits = false, excludeSlug } = Astro.props;
const services = (await getCollection('services')).filter((service) => !service.data.draft && service.data.status === 'active' && service.data.slug !== excludeSlug).sort((a, b) => a.data.order - b.data.order);
const Heading = variant === 'home' ? 'h3' : 'h2';
const serviceBenefitItems = (service: import('astro:content').CollectionEntry<'services'>) => service.data.blocks.find((item) => item.component === 'feature-card-grid')?.items.slice(0, 3).map((item) => item.title) ?? [];
---
<section id={id} class={variant === 'home' ? 'service-list service-list--home' : 'service-list'}>
  <div class={variant === 'home' ? 'service-list__container' : ''}>
    {(eyebrow || heading || description) && <header class="service-list__header">
      {eyebrow && <p class="service-list__eyebrow">{eyebrow}</p>}
      {heading && <h2 class="service-list__heading">{heading}</h2>}
      {description && <p class="service-list__description">{description}</p>}
    </header>}
    {services.length ? <ul class:list={['service-list__grid', `service-list__grid--${columns}`]} role="list">
      {services.map((service, index) => <li><article class="service-list-card">
        <p class="service-list-card__eyebrow">{variant === 'home' ? String(index + 1).padStart(2, '0') : service.data.serviceGroup}</p>
        <Heading class="service-list-card__title">{service.data.title}</Heading>
        <p class="service-list-card__description">{service.data.description}</p>
        {showBenefits && serviceBenefitItems(service).length > 0 && <ul class="service-list-card__benefits">{serviceBenefitItems(service).map((point) => <li>{point}</li>)}</ul>}
        <a href={`/services/${service.data.slug}/`} class="service-list-card__link">{ui.services.readMore}</a>
      </article></li>)}
    </ul> : <p class="service-list__empty">{ui.services.emptyList}</p>}
  </div>
</section>
