---
const { id, heading, head, rows, class: css } = Astro.props;
---
<section id={id} class={`table-block ${css?.section ?? ''}`} aria-labelledby={heading ? `${id}-title` : undefined}>
  {heading && <h2 id={`${id}-title`} class={`table-block__heading ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`table-block__scroll ${css?.wrapper ?? ''}`} role="region" aria-label={heading ?? 'Tabel informasi'} tabindex="0">
    <table class={`table-block__table ${css?.table ?? ''}`}>
      <thead><tr>{head.map((label: string) => <th scope="col">{label}</th>)}</tr></thead>
      <tbody>{rows.map((row: string[], index: number) => <tr class={index % 2 ? 'table-block__row table-block__row--alt' : 'table-block__row'}>{row.map((cell: string) => <td>{cell}</td>)}</tr>)}</tbody>
    </table>
  </div>
</section>
