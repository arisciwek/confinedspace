---
const { id, title, steps } = Astro.props as { id: string; title: string; steps: { title: string; description: string }[] };
const titleId = `${id}-title`;
---
<section id={id} class="process-timeline-block" aria-labelledby={titleId}>
  <h2 id={titleId} class="process-timeline-block__heading">{title}</h2>
  <ol class="process-timeline-block__list">
    {steps.map((step, index) => <li class="process-timeline-block__item">
      <span class="process-timeline-block__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div class="process-timeline-block__body">
        <h3 class="process-timeline-block__title">{step.title}</h3>
        <p class="process-timeline-block__description">{step.description}</p>
      </div>
    </li>)}
  </ol>
</section>
