---
import { site } from '../../config/site.ts';
const { eyebrow, title, intro, image } = Astro.props as {
  eyebrow: string;
  title: string;
  intro: string;
  image?: string;
};
const consultationUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Halo, saya ingin berkonsultasi mengenai ${title}.`)}`;
---
<header class="service-hero" aria-labelledby="service-title">
  {image && <div class="service-hero__media" aria-hidden="true"><img src={image} alt="" fetchpriority="high" decoding="async" /></div>}
  <div class="wrap service-hero__inner">
    <div class="service-hero__content">
      <p class="service-hero__eyebrow">{eyebrow}</p>
      <h1 id="service-title">{title}</h1>
      <p class="service-hero__lead">{intro}</p>
      <div class="service-hero__actions">
        <a class="btn btn-gold" href={consultationUrl} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true"><use href="#i-wa" /></svg>
          Konsultasi Program
        </a>
        <a class="service-hero__text-link" href="#service-content">Pelajari program <span aria-hidden="true">↓</span></a>
      </div>
      <p class="service-hero__trust">Pembinaan K3 ruang terbatas · Informasi program untuk perusahaan dan peserta individu</p>
    </div>
  </div>
</header>
