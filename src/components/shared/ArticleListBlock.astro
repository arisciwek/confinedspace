---
/**
 * ArticleListBlock — block daftar artikel terbaru.
 *
 * Dipakai di:
 * - halaman depan (home): mode "latest", offset 0, limit 3 → artikel #1–3
 * - halaman layanan (services): mode "listing", offset 3, limit 3 → artikel #4–6
 *
 * Sort descending dari updatedDate (fallback pubDate); tie-break id lebih besar dulu.
 * Render tepat sebelum penutup </main> di halaman masing-masing.
 */
import { getCollection } from 'astro:content';
import ArticleListItem from './ArticleListItem.astro';
import { ui } from '../../config/ui.ts';

const { id, heading, description, mode = 'listing', limit = 0, offset = 0 } = Astro.props;

const allArticles = (await getCollection('articles'))
  .filter((article) => !article.data.draft && article.data.contentType !== 'local-seo')
  .sort((a, b) => {
    const aDate = (a.data.updatedDate ?? a.data.pubDate).valueOf();
    const bDate = (b.data.updatedDate ?? b.data.pubDate).valueOf();
    return bDate - aDate || b.data.id - a.data.id;
  });

const articles = allArticles.slice(Math.max(0, offset), limit > 0 ? Math.max(0, offset) + limit : undefined);
---
<section id={id} class="section article-list">
  <div class="wrap">
    <div class="article-list__head">
      <header class="section-title">
        <p class="section-label">{ui.article.latestEyebrow}</p>
        <h2>{heading}</h2>
        {description && <p>{description}</p>}
      </header>
      {mode === 'latest' && <a class="article-list__all" href="/articles/">{ui.article.allArticlesLink}</a>}
    </div>
    {articles.length ? (
      <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => <ArticleListItem article={article} />)}
      </ul>
    ) : (
      <p class="article-list__empty">{ui.article.emptyList}</p>
    )}
  </div>
</section>