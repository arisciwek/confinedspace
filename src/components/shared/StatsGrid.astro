---
import { ui } from '../../config/ui.ts';
const { id, items } = Astro.props as { id: string; items: { value: string; label: string }[] };
---
<section id={id} class="stats-grid-block" aria-label={ui.stats.ariaLabel}>
  <div class="stats-grid-block__grid">
    {items.map((item) => <article class="stats-grid-block__item"><p class="stats-grid-block__value">{item.value}</p><p class="stats-grid-block__label">{item.label}</p></article>)}
  </div>
</section>
