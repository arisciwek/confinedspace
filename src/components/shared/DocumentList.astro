---
import { ui } from '../../config/ui.ts';
const { id, title, intro, items } = Astro.props;
const titleId = `${id}-title`;
---
<section id={id} class="document-list-block" aria-labelledby={titleId}>
  <h2 id={titleId} class="document-list-block__heading">{title}</h2>
  {intro && <p class="document-list-block__intro">{intro}</p>}
  <ul class="document-list-block__grid">
    {items.map((item: { name: string; purpose?: string; mandatory?: boolean }) => <li class="document-list-card">
      <span class="document-list-card__icon" aria-hidden="true">▤</span>
      <div class="document-list-card__body">
        <h3 class="document-list-card__title">{item.name}</h3>
        {item.purpose && <p class="document-list-card__purpose">{item.purpose}</p>}
        {item.mandatory && <span class="document-list-card__badge">{ui.blocks.documentMandatoryLabel}</span>}
      </div>
    </li>)}
  </ul>
</section>
