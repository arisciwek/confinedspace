---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`faq-block ${css?.section ?? ''}`} aria-labelledby={heading ? `${id}-title` : undefined}>
  {heading && <h2 id={`${id}-title`} class={`faq-block__heading ${css?.heading ?? ''}`}>{heading}</h2>}
  <div class={`faq-block__list ${css?.list ?? ''}`}>
    {items.map((item: { question: string; answer: string }, index: number) => <details class={`faq-block__item ${css?.item ?? ''}`} open={index === 0}>
      <summary class={`faq-block__question ${css?.summary ?? ''}`}><span>{item.question}</span><svg aria-hidden="true" viewBox="0 0 24 24" class="faq-block__icon"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
      <div class={`faq-block__answer ${css?.answer ?? ''}`}><p>{item.answer}</p></div>
    </details>)}
  </div>
</section>
