---
const { id, heading, items, class: css } = Astro.props;
---
<section id={id} class={`steps-block ${css?.section ?? ''}`} aria-labelledby={heading ? `${id}-title` : undefined}>
  {heading && <h2 id={`${id}-title`} class={`steps-block__heading ${css?.heading ?? ''}`}>{heading}</h2>}
  <ol class={`steps-block__list ${css?.list ?? ''}`}>
    {items.map((item: { title: string; text: string }, index: number) => <li class={`steps-block__item ${css?.item ?? ''}`}>
      <span class={`steps-block__number ${css?.badge ?? ''}`} aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <div class="steps-block__body"><h3 class={`steps-block__title ${css?.title ?? ''}`}>{item.title}</h3><p class={`steps-block__text ${css?.text ?? ''}`}>{item.text}</p></div>
    </li>)}
  </ol>
</section>
